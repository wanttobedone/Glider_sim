<!--
  ug_control 控制层启动文件，启动状态转换节点，PID 控制器，任务节点
  多机模式下通过不同 namespace 参数生成不同节点名，避免冲突
-->
<launch>
  <arg name="namespace" default="ug_glider"/>
  <arg name="mission" default="true"/>
  <arg name="use_ground_truth" default="false"/>

  <!-- 状态转换: ENU Odometry → NED GliderState -->
  <!-- use_ground_truth:=true 时订阅 P3D 真值，false 时订阅 EKF 输出 -->
  <node name="$(arg namespace)_state_converter" pkg="ug_control" type="state_converter_node" output="screen">
    <param name="namespace" value="$(arg namespace)"/>
    <param name="use_ground_truth" value="$(arg use_ground_truth)"/>
  </node>

  <!-- PID控制器 -->
  <node name="$(arg namespace)_control_node" pkg="ug_control" type="control_node" output="screen">
    <param name="namespace" value="$(arg namespace)"/>
    <rosparam file="$(find ug_control)/config/pid_params.yaml" command="load"/>
  </node>

  <!-- 任务节点 (zigzag，dynamic_reconfigure) -->
  <node if="$(arg mission)" name="$(arg namespace)_mission_node" pkg="ug_control" type="mission_node" output="screen">
    <param name="namespace" value="$(arg namespace)"/>
    <rosparam file="$(find ug_control)/config/mission_params.yaml" command="load"/>
  </node>
</launch>
