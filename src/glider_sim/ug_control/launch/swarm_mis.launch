<!--
  编队覆盖任务层（规划器 + 可视化）
  独立于世界和滑翔机生成，可在 swarm_coverage.launch 启动后单独触发
  用法：roslaunch ug_control swarm_mis.launch
-->
<launch>
  <!-- 共享参数，一处定义，planner 和 viz 都从 /swarm/ 读取 -->
  <rosparam ns="swarm">
    glider_namespaces: ["ug_glider_0", "ug_glider_1", "ug_glider_2"]
    area_center_north: 200.0
    area_center_east: 12.5
    area_length: 400.0
    area_width: 50.0
    area_depth: 100.0
    swath_width: 50.0
    detect_radius: 25.0
    voxel_size: 1
    anomaly_north: 100.0
    anomaly_east: -5
    anomaly_depth: 25.0
    anomaly_detect_radius: 25.0
  </rosparam>

  <!-- swarm覆盖任务规划器 -->
  <node name="swarm_planner" pkg="ug_control" type="swarm_planner_node" output="screen"/>

  <!-- 海底目标节点 -->
  <node name="anomaly_field" pkg="ug_comm" type="anomaly_field_node" output="screen"/>

  <!-- 通信代理，每台 Glider 实例化一个 -->
  <node name="ug_glider_0_comm" pkg="ug_comm" type="comm_agent_node" output="screen">
    <param name="namespace" value="ug_glider_0"/>
  </node>
  <node name="ug_glider_1_comm" pkg="ug_comm" type="comm_agent_node" output="screen">
    <param name="namespace" value="ug_glider_1"/>
  </node>
  <node name="ug_glider_2_comm" pkg="ug_comm" type="comm_agent_node" output="screen">
    <param name="namespace" value="ug_glider_2"/>
  </node>

  <!-- G2 中继站：control_node 切手动模式，pitch PID 跟踪 17.25° -->
  <node name="ug_glider_2_mode" pkg="rostopic" type="rostopic"
        args="pub -r 1 /ug_glider_2/cmd/mode std_msgs/Int32 'data: 0'" output="log"/>
  <node name="ug_glider_2_pitch" pkg="rostopic" type="rostopic"
        args="pub -r 1 /ug_glider_2/cmd/pitch std_msgs/Float64 'data: 0.301'" output="log"/>

  <!-- 编队可视化 -->
  <node name="swarm_viz" pkg="ug_viz" type="swarm_viz_node" output="screen"/>
</launch>
