<!--
  状态估计层启动文件
  estimator:=robot_localization  (默认) — depth_converter + robot_localization EKF (baseline)
  estimator:=ug_eskf             — ESKF glider_ekf_node (NED-FRD core)
-->
<launch>
  <arg name="namespace" default="ug_glider"/>
  <arg name="estimator" default="ug_eskf"/>
  <!-- 自研 ESKF 的 NED 初始航向 (默认场景 spawn ENU yaw=1.5708 → NED yaw=0) -->
  <arg name="init_yaw_ned_rad" default="0.0"/>

  <!--   baseline: robot_localization   -->
  <group if="$(eval estimator == 'robot_localization')">
    <!-- 深度转换: FluidPressure → PoseWithCovarianceStamped -->
    <node name="depth_converter" pkg="ug_estimation" type="depth_converter_node"
          ns="$(arg namespace)" output="screen">
      <param name="output_frame" value="$(arg namespace)/odom"/>
    </node>

    <!-- EKF: IMU 姿态/角速度/线加速度 + 深度 z -->
    <node name="ekf_se" pkg="robot_localization" type="ekf_localization_node"
          ns="$(arg namespace)" clear_params="true" output="screen">
      <rosparam command="load" file="$(find ug_estimation)/config/ekf.yaml"/>
      <param name="base_link_frame" value="$(arg namespace)/base_link"/>
      <param name="odom_frame" value="$(arg namespace)/odom"/>
      <param name="world_frame" value="$(arg namespace)/odom"/>
    </node>
  </group>

  <!--   自研 ESKF: ug_eskf   -->
  <group if="$(eval estimator == 'ug_eskf')">
    <node name="glider_ekf" pkg="ug_estimation" type="glider_ekf_node"
          ns="$(arg namespace)" output="screen">
      <rosparam command="load" file="$(find ug_estimation)/config/eskf.yaml"/>
      <param name="namespace" value="$(arg namespace)"/>
      <param name="init_yaw_ned_rad" value="$(arg init_yaw_ned_rad)"/>
      <param name="odom_frame" value="$(arg namespace)/odom"/>
      <param name="base_frame" value="$(arg namespace)/base_link"/>
    </node>
  </group>
</launch>
