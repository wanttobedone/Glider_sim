<?xml version="1.0"?>
<sdf version="1.6">
  <model name="checkerboard_target">
    <static>true</static>
    <link name="target_link">
      <pose>0 0 0 0 0 0</pose>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>1.2</radius>
            <length>3.0</length>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode/>
          </contact>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>1.2</radius>
            <length>3.0</length>
          </cylinder>
        </geometry>
        <material>
          <script>
            <uri>model://checkerboard_target/materials/scripts</uri>
            <uri>model://checkerboard_target/materials/textures</uri>
            <name>Checkerboard/Pattern</name>
          </script>
        </material>
      </visual>
    </link>
  </model>
</sdf>
