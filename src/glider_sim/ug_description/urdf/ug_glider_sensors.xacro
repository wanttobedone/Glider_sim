<?xml version="1.0"?>
<!--
  传感器仿真，部分参考自uuv_simulator
  IMU惯导、压力传感器(深度)、GPS(仅水面)、DVL(后续开发)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 传感器参数 -->

  <!-- IMU 位置，相对于 base_link，实机在电路板位置-->
  <xacro:property name="imu_x" value="0.0"/>
  <xacro:property name="imu_y" value="0.0"/>
  <xacro:property name="imu_z" value="0.0"/>

  <!-- 压力传感器位置，相对于base_link -->
  <xacro:property name="pressure_x" value="0.0"/>
  <xacro:property name="pressure_y" value="0.0"/>
  <xacro:property name="pressure_z" value="0.1"/>

  <!-- 磁力计位置，相对于base_link，与 IMU 同位置 -->
  <xacro:property name="mag_x" value="0.0"/>
  <xacro:property name="mag_y" value="0.0"/>
  <xacro:property name="mag_z" value="0.0"/>

  <!-- 宏定义-->

  <xacro:macro name="ug_glider_sensors" params="namespace">

    <!--IMU 惯性测量单元 (使用 ros-noetic-gazebo-plugins 的 SensorPlugin) -->
    <link name="${namespace}/imu_link">
      <inertial>
        <mass value="0.01"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>

    <joint name="${namespace}/imu_joint" type="fixed">
      <parent link="${namespace}/base_link"/>
      <child link="${namespace}/imu_link"/>
      <origin xyz="${imu_x} ${imu_y} ${imu_z}" rpy="0 0 0"/>
    </joint>

    <gazebo reference="${namespace}/imu_link">
      <sensor name="${namespace}_imu" type="imu">
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <imu>
          <angular_velocity>
            <!-- 陀螺仪: stddev=实测值, 零偏~1 deg/s, 零偏稳定性~5 deg/hr -->
            <x><noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.00122</stddev>
              <bias_mean>0.0</bias_mean>
              <bias_stddev>0.017</bias_stddev>
              <dynamic_bias_stddev>0.00015</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>300.0</dynamic_bias_correlation_time>
            </noise></x>
            <y><noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.00122</stddev>
              <bias_mean>0.0</bias_mean>
              <bias_stddev>0.017</bias_stddev>
              <dynamic_bias_stddev>0.00015</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>300.0</dynamic_bias_correlation_time>
            </noise></y>
            <z><noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.00122</stddev>
              <bias_mean>0.0</bias_mean>
              <bias_stddev>0.017</bias_stddev>
              <dynamic_bias_stddev>0.00015</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>300.0</dynamic_bias_correlation_time>
            </noise></z>
          </angular_velocity>
          <linear_acceleration>
            <!-- 加速度计: stddev=实测值, 零偏~40 mg, 零偏稳定性~0.5 mg -->
            <x><noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.00981</stddev>
              <bias_mean>0.0</bias_mean>
              <bias_stddev>0.39</bias_stddev>
              <dynamic_bias_stddev>0.005</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>300.0</dynamic_bias_correlation_time>
            </noise></x>
            <y><noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.00981</stddev>
              <bias_mean>0.0</bias_mean>
              <bias_stddev>0.39</bias_stddev>
              <dynamic_bias_stddev>0.005</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>300.0</dynamic_bias_correlation_time>
            </noise></y>
            <z><noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.00981</stddev>
              <bias_mean>0.0</bias_mean>
              <bias_stddev>0.39</bias_stddev>
              <dynamic_bias_stddev>0.005</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>300.0</dynamic_bias_correlation_time>
            </noise></z>
          </linear_acceleration>
        </imu>
        <plugin name="${namespace}_imu_plugin" filename="libgazebo_ros_imu_sensor.so">
          <topicName>${namespace}/imu</topicName>
          <bodyName>${namespace}/imu_link</bodyName>
          <frameName>${namespace}/imu_link</frameName>
          <updateRateHZ>50.0</updateRateHZ>
          <gaussianNoise>0.0</gaussianNoise>
        </plugin>
      </sensor>
    </gazebo>

    <!--压力传感器，深度测量 (自研 ug_sensor 插件，替代 UUV 的有 segfault 问题的版本) -->
    <link name="${namespace}/pressure_link">
      <inertial>
        <mass value="0.01"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>

    <joint name="${namespace}/pressure_joint" type="fixed">
      <parent link="${namespace}/base_link"/>
      <child link="${namespace}/pressure_link"/>
      <origin xyz="${pressure_x} ${pressure_y} ${pressure_z}" rpy="0 0 0"/>
    </joint>

    <!-- 防止 fixed joint 把 pressure_link 合并进 base_link，否则插件按名字找不到 -->
    <gazebo reference="${namespace}/pressure_link">
      <disableFixedJointLumping>true</disableFixedJointLumping>
    </gazebo>
    <gazebo reference="${namespace}/pressure_joint">
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <gazebo>
      <plugin name="${namespace}_pressure_plugin" filename="libug_pressure_sensor_plugin.so">
        <robot_namespace>${namespace}</robot_namespace>
        <link_name>${namespace}/pressure_link</link_name>
        <sensor_topic>pressure</sensor_topic>
        <update_rate>10</update_rate>
        <noise_sigma>100.0</noise_sigma>
        <standard_pressure>101325.0</standard_pressure>
        <water_density>1028.0</water_density>
        <gravity>9.81</gravity>
      </plugin>
    </gazebo>

    <!-- 磁力计 (自研 ug_sensor 插件) -->
    <link name="${namespace}/mag_link">
      <inertial>
        <mass value="0.001"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
      </inertial>
    </link>

    <joint name="${namespace}/mag_joint" type="fixed">
      <parent link="${namespace}/base_link"/>
      <child link="${namespace}/mag_link"/>
      <origin xyz="${mag_x} ${mag_y} ${mag_z}" rpy="0 0 0"/>
    </joint>

    <!-- 防止 fixed joint 把 mag_link 合并进 base_link -->
    <gazebo reference="${namespace}/mag_link">
      <disableFixedJointLumping>true</disableFixedJointLumping>
    </gazebo>
    <gazebo reference="${namespace}/mag_joint">
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <gazebo>
      <plugin name="${namespace}_mag_plugin" filename="libug_magnetometer_plugin.so">
        <robot_namespace>${namespace}</robot_namespace>
        <link_name>${namespace}/mag_link</link_name>
        <sensor_topic>mag</sensor_topic>
        <update_rate>50</update_rate>
        <reference_frame>ENU</reference_frame>
        <field_strength_T>5.0e-5</field_strength_T>
        <declination_deg>0.0</declination_deg>
        <inclination_deg>45.0</inclination_deg>
        <noise_sigma_T>5.0e-7</noise_sigma_T>
        <hard_iron_T>0 0 0</hard_iron_T>
        <soft_iron>1 0 0  0 1 0  0 0 1</soft_iron>
      </plugin>
    </gazebo>

  </xacro:macro>

</robot>
