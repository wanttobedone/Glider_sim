Panels:
  - Class: rviz/Displays
    Help Height: 85
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Glider 0 Model1
        - /Glider 1 Model1
        - /Swarm Trajectories1
        - /Anomaly Target1
        - /Anomaly Target1/Namespaces1
      Splitter Ratio: 0.5
    Tree Height: 1829
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 100; 100; 100
      Enabled: true
      Line Style:
        Line Width: 0.019999999552965164
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 1
      Class: rviz/RobotModel
      Collision Enabled: false
      Enabled: true
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
        Link Tree Style: Links in Alphabetic Order
        ug_glider_0/base_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        ug_glider_0/battery_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        ug_glider_0/battery_slide_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        ug_glider_0/bladder_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        ug_glider_0/rudder_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        ug_glider_0/wing_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
      Name: Glider 0 Model
      Robot Description: /ug_glider_0/robot_description
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /ug_glider_0/viz/markers
      Name: G0 Markers
      Namespaces:
        attitude: true
        target_depth: true
        target_heading: true
        velocity: true
        water_surface: true
      Queue Size: 1
      Value: true
    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /ug_glider_0/viz/status_text
      Name: G0 Status Text
      Namespaces:
        status_text: true
      Queue Size: 1
      Value: true
    - Class: rviz/MarkerArray
      Enabled: false
      Marker Topic: /ug_glider_0/ocean_current_markers
      Name: G0 Ocean Current
      Namespaces:
        {}
      Queue Size: 1
      Value: false
    - Alpha: 1
      Class: rviz/RobotModel
      Collision Enabled: false
      Enabled: true
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
        Link Tree Style: Links in Alphabetic Order
        ug_glider_1/base_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        ug_glider_1/battery_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        ug_glider_1/battery_slide_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        ug_glider_1/bladder_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        ug_glider_1/rudder_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        ug_glider_1/wing_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
      Name: Glider 1 Model
      Robot Description: /ug_glider_1/robot_description
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /ug_glider_1/viz/markers
      Name: G1 Markers
      Namespaces:
        attitude: true
        target_depth: true
        target_heading: true
        velocity: true
        water_surface: true
      Queue Size: 1
      Value: true
    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /ug_glider_1/viz/status_text
      Name: G1 Status Text
      Namespaces:
        status_text: true
      Queue Size: 1
      Value: true
    - Class: rviz/MarkerArray
      Enabled: false
      Marker Topic: /ug_glider_1/ocean_current_markers
      Name: G1 Ocean Current
      Namespaces:
        {}
      Queue Size: 1
      Value: false
    - Class: rviz/TF
      Enabled: false
      Filter (blacklist): ""
      Filter (whitelist): ""
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Alpha: 1
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        {}
      Update Interval: 0
      Value: false
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /swarm/trajectories
      Name: Swarm Trajectories
      Namespaces:
        trajectory_ug_glider_0: true
        trajectory_ug_glider_1: true
      Queue Size: 1
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /swarm/waypoints
      Name: Swarm Waypoints
      Namespaces:
        wp_line_ug_glider_0: true
        wp_line_ug_glider_1: true
        wp_ug_glider_0: true
        wp_ug_glider_1: true
      Queue Size: 1
      Value: true
    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /swarm/planned_area
      Name: Planned Area
      Namespaces:
        planned_area: true
      Queue Size: 1
      Value: true
    - Class: rviz/Marker
      Enabled: false
      Marker Topic: /swarm/coverage_volume
      Name: Coverage Volume
      Namespaces:
        {}
      Queue Size: 1
      Value: false
    - Class: rviz/MarkerArray
      Enabled: false
      Marker Topic: /swarm/detection_spheres
      Name: Detection Spheres
      Namespaces:
        {}
      Queue Size: 1
      Value: false
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /swarm/anomaly_markers
      Name: Anomaly Target
      Namespaces:
        acoustic_wave: true
        anomaly_detect_range: false
        anomaly_target: true
        comm_link: true
      Queue Size: 1
      Value: true
  Enabled: true
  Global Options:
    Background Color: 10; 20; 40
    Default Light: true
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 306.7193298339844
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Field of View: 0.7853981852531433
      Focal Point:
        X: -4.768648624420166
        Y: 37.45654296875
        Z: -8.823357582092285
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 0.2549997866153717
      Target Frame: world
      Yaw: 4.8600006103515625
    Saved: ~
